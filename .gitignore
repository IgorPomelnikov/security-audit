# =============================================================================
# BPMSoft Local Development - .gitignore
# =============================================================================

# =============================================================================
# SSL/TLS СЕРТИФИКАТЫ
# =============================================================================
# Все сертификаты и ключи должны быть исключены из репозитория
# Они содержат конфиденциальную информацию и создаются локально

# Сертификаты PostgreSQL
certs/server/postgres/
certs/client/postgres/
certs/ca/postgres/

# Сертификаты Redis
certs/server/redis/
certs/client/redis/
certs/ca/redis/

# Сертификаты RabbitMQ
certs/server/rabbitmq/
certs/client/rabbitmq/
certs/ca/rabbitmq/

# Все файлы сертификатов (дополнительная защита)
*.crt
*.key
*.pem
*.p12
*.pfx
*.cer
*.der
*.csr
*.srl

# Директории с сертификатами
certs/*
certificates/
ssl/
tls/

# Разрешаем хранить пустой каталог доверенных CA в репозитории (без самих сертификатов)
!certs/trust/
!certs/trust/.gitkeep

# Разрешаем хранить публичные сертификаты в доверенном каталоге
!certs/trust/*.crt
!certs/trust/*.cer
!certs/trust/*.pem
!certs/trust/*.der

# Данные сервисов (создаются локально)
RabbitMQ_Data/
DB_Data/PG_Data/
BPMSoft_Data/Logs/
BPMSoft_Data/logs/

# =============================================================================
# КОНФИГУРАЦИЯ И СЕКРЕТЫ
# =============================================================================
.env
.env.local
.env.*.local
compose.yaml
docker-compose.override.yml

# Архивы пакетов (создаются скриптом zip-package)
archives/

# =============================================================================
# ДАМПЫ И БЭКАПЫ БД (внутри DB_Data/init)
# =============================================================================
DB_Data/init/*_dump_*.backup
DB_Data/init/*_dump_*.backup.gz
DB_Data/init/*_dump_*.backup.tar.gz
DB_Data/init/OCRM_dump_*
DB_Data/init/CRMCC_dump_*

# Логи дампов и восстановления
DB_Data/init/dump_*.log
DB_Data/init/restore_*.log

# Временные директории дампов
DB_Data/init/*_dir/
DB_Data/init/*_dir

# Разрешаем отслеживание каталога pgAdmin как и init
!DB_Data/PGAdmin/

# =============================================================================
# BPMSoft_Data - ИГНОРИРУЕМ ЛОКАЛЬНЫЕ ИЗМЕНЕНИЯ
# =============================================================================
# Используем git update-index --skip-worktree для игнорирования локальных изменений
# Файлы остаются в репозитории, но локальные изменения игнорируются

# ЛОГИ BPMSoft (дополнительно)
BPMSoft_Data/Logs/*
BPMSoft_Data/logs/*
BPMSoft_Data/*.log

# НОВЫЕ ФАЙЛЫ BPMSoft (создаются при загрузке пакетов)
BPMSoft_Data/ocrm/
BPMSoft_Data/conf/

# =============================================================================
# ВРЕМЕННЫЕ ФАЙЛЫ
# =============================================================================
# Системные временные файлы
*.tmp
*.temp
*.log
*.pid
*.lock
*.bak
# *.backup  # Убрано для добавления BPMSoft_Full_House_1.6.0.200.backup
*.old

# Временные архивы
*.tar.gz.tmp
*.zip.tmp

# =============================================================================
# DOCKER
# =============================================================================
.docker/
docker-compose.override.yml
.dockerignore

# =============================================================================
# IDE И РЕДАКТОРЫ
# =============================================================================
# Visual Studio Code
.vscode/
!.vscode/settings.json.example
!.vscode/launch.json.example

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# Vim/Neovim
*.swp
*.swo
*~
.netrwhist

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc

# Sublime Text
*.sublime-project
*.sublime-workspace

# =============================================================================
# ОПЕРАЦИОННЫЕ СИСТЕМЫ
# =============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# =============================================================================
# ЯЗЫКИ ПРОГРАММИРОВАНИЯ
# =============================================================================
# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity
.pnp.*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/env/
venv/
ENV/
/env.bak/
venv.bak/
.pytest_cache/

# Java
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*

# =============================================================================
# СИСТЕМНЫЕ ФАЙЛЫ
# =============================================================================
# KDE
.kde4/

# =============================================================================
# ПРОЕКТ-СПЕЦИФИЧНЫЕ
# =============================================================================
# Временные файлы проекта
*.local
*.dev
*.test

# Логи отладки и исправлений
fix_migration.log

# Локальная история сеансов (не храним в git)
history/

# =============================================================================
# CRMCC - ОТДЕЛЬНЫЙ GIT РЕПОЗИТОРИЙ
# =============================================================================
# crmcc теперь добавлен как git submodule, поэтому не игнорируем его
# BPMSoft_Data/crmcc/

# =============================================================================
# GIT АТРИБУТЫ - ИГНОРИРОВАНИЕ ПРАВ ДОСТУПА И ВЛАДЕЛЬЦЕВ
# =============================================================================
# Игнорируем изменения прав доступа и владельцев для всех файлов
# Это предотвращает проблемы с правами при работе в Docker контейнерах
* -diff
* -text
* -eol
